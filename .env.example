# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=seu_token_aqui

# ID do servidor (recomendado na Discloud)
DISCORD_GUILD_ID=

# Donos do bot (IDs separados por vírgula) — painel técnico completo
BOT_OWNER_IDS=123456789012345678,987654321098765432

BOT_NAME=LegionAsphaltBot

# Nome da legião (título do painel)
LEGION_NAME=Legião Espartan

# Canal onde o painel interativo fica fixo (obrigatório para uso sem slash)
PANEL_CHANNEL_ID=

# URLs de imagens/GIFs do logo, separadas por vírgula — o bot alterna para efeito "animação"
# Ex.: frame1.gif,frame2.gif,frame3.gif (hospede no Imgur, Discord CDN, etc.)
PANEL_LOGO_URLS=

# Segundos entre troca de frame do logo (2–60)
LOGO_CYCLE_SECONDS=4
