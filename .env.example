# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=seu_token_aqui

# Opcional: ID do servidor para sincronizar comandos slash mais rápido durante desenvolvimento
DISCORD_GUILD_ID=

# IDs de administradores do bot (separados por vírgula) — acesso a comandos /admin_*
BOT_OWNER_IDS=123456789012345678,987654321098765432

# Prefixo opcional para mensagens de sistema (apenas informativo)
BOT_NAME=Asphalt9ClubBot
